# ==============================================================================
# InferenceOS Production Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE OPERATIONAL MODES (Render & Local)
# ------------------------------------------------------------------------------
# Default is true: Enables zero-cost deterministic mock responses for public demos.
# Set MOCK_MODE=false in production once you supply your live provider keys.
MOCK_MODE=true

# Strict enforcement rejecting unknown or paid model endpoints (HTTP 400).
FREE_MODE_ONLY=true

# Server networking (Render injects PORT dynamically; 8000 for local)
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. CORS & FRONTEND URL (Render)
# ------------------------------------------------------------------------------
# Set this on Render to your deployed Vercel domain, e.g. https://inferenceos.vercel.app
FRONTEND_URL=http://localhost:3000

# Additional allowed origins (JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# ------------------------------------------------------------------------------
# 3. DATABASE & PERSISTENCE (Render & Local)
# ------------------------------------------------------------------------------
# PostgreSQL (Production Render): postgresql+asyncpg://user:password@hostname:5432/dbname
# SQLite (Local Development): sqlite+aiosqlite:///./inferenceos.db
DATABASE_URL=sqlite+aiosqlite:///./inferenceos.db

# ------------------------------------------------------------------------------
# 4. CACHE & RATE LIMITING (Render & Local)
# ------------------------------------------------------------------------------
# Redis instance URL (e.g., redis://red-xxxx:6379 on Render).
# If left empty, InferenceOS automatically operates with in-memory fallback.
REDIS_URL=
ENABLE_REDIS_CACHE=false

# ------------------------------------------------------------------------------
# 5. SUPPORTED AI PROVIDER CREDENTIALS (Render)
# ------------------------------------------------------------------------------
# Groq: Free tier accounts get access to open-weight models (gpt-oss-20b, qwen3.8-27b, llama-3.3-70b)
GROQ_API_KEY=

# Google Gemini: Free tier via Google AI Studio (gemini-2.0-flash, gemini-1.5-flash)
GEMINI_API_KEY=

# OpenRouter: Explicitly free models only (:free suffix strictly enforced)
OPENROUTER_API_KEY=

# Inception Labs Mercury: Diffusion LLMs (dLLMs) using promotional trial credits (100M tokens)
INCEPTION_API_KEY=

# Optional local/remote vLLM endpoint (OpenAI-compatible)
# Note: For remote production deployments, point to your external cluster URL, not localhost.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=

# ------------------------------------------------------------------------------
# 6. VERCEL FRONTEND ENVIRONMENT VARIABLE (Set in Vercel Project Settings)
# ------------------------------------------------------------------------------
# Point this to your live Render backend URL (e.g. https://inferenceos-api.onrender.com)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_MOCK_MODE=true
