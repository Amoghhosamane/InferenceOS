# InferenceOS Environment Configuration Template
# IMPORTANT: Never commit actual API keys to version control.
# Copy this file to .env or .env.local to configure your environment.

# Mode toggles
# When MOCK_MODE is true, InferenceOS provides deterministic mock responses
# requiring zero external API keys and guaranteeing zero external cost.
# Set MOCK_MODE=false to enable real live provider requests.
MOCK_MODE=true

# When FREE_MODE_ONLY is true (default: true), InferenceOS strictly rejects any model
# that is not explicitly verified on a free-tier allowlist or promotional trial.
FREE_MODE_ONLY=true

# Server configuration
# Note: FastAPI runs on port 8000 by default.
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database & persistence
# Supports PostgreSQL (postgresql+asyncpg://user:password@localhost:5432/inferenceos)
# or SQLite (sqlite+aiosqlite:///./inferenceos.db) for zero-dependency local development
DATABASE_URL=sqlite+aiosqlite:///./inferenceos.db

# Cache & Rate Limiting (Redis)
# Provide a Redis connection string (e.g. redis://localhost:6379/0) to enable distributed sliding-window
# rate limiting and response caching. If left empty, automatic in-memory fallback is used.
REDIS_URL=
ENABLE_REDIS_CACHE=false

# --- Supported AI Provider Credentials ---

# 1. Groq: Free tier accounts get access to selected open-weight models
# Includes: openai/gpt-oss-20b, openai/gpt-oss-120b, qwen/qwen3.8-27b, llama-3.3-70b-versatile
GROQ_API_KEY=

# 2. Google Gemini: Free tier via Google AI Studio (gemini-2.0-flash, gemini-1.5-flash, etc.)
GEMINI_API_KEY=

# 3. OpenRouter: Access to explicitly free models (:free suffix strictly enforced)
OPENROUTER_API_KEY=

# 4. Inception Labs Mercury API: Diffusion LLMs (dLLMs) using promotional trial credits (100M tokens)
# Note: Mercury promotional trial credits are temporary, not permanently free.
INCEPTION_API_KEY=

# 5. Optional local vLLM / self-hosted endpoint (OpenAI-compatible)
# Configured on port 8001 to prevent conflicts with FastAPI on port 8000.
VLLM_BASE_URL=http://localhost:8001/v1
VLLM_API_KEY=

# Frontend environment variables (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_DEFAULT_MOCK_MODE=true
